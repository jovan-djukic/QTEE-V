{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug C Program with libcurl, libssl, libcrypto",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/eapp_final", // or replace with your binary name
      "args": [ ],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb", // or "lldb" for LLVM/Clang
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "C/C++: gcc build active file",
      "miDebuggerPath": "/usr/bin/gdb", // or /usr/bin/lldb
    }
  ]
}