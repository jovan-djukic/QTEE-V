+    let pkb(r0_pk: pkey) = r0_pkb in
+
+    (* PQC mTLS client handshake: send our cert + TLS session key. *)
+    new k: bitstring;
+    out(net, (app_cert, aenc(k, r0_pk)));
+
+    (* Send secret_msg inside TLS — no QKD layer on the app side. *)
+    event AppSubmitted(secret_msg);
+    out(net, senc((secret_msg, APP_L), k)).
