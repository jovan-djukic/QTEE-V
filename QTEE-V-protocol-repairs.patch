+(* ================================================================ *)
+(*  Application source process                                      *)
+(*                                                                  *)
+(*  Models APP_L sending secret_msg to R0 over PQC TLS (no QKD). *)
+(*  Makes the attacker(secret_msg) secrecy query non-vacuous by   *)
+(*  giving ProVerif a concrete execution trace through the chain.  *)
+(* ================================================================ *)
+let AppSource(app_sk: skey, app_cert: bitstring, ca_pkb: bitstring) =
+
+    (* Read R0's published cert to learn its public key. *)
+    in(net, r0_cert: bitstring);
+    if cert_ok(r0_cert, ca_pkb) = ok() then
+    if cert_getid(r0_cert) = R0 then
